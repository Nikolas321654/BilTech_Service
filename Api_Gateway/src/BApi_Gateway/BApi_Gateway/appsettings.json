{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "shop-router": {
        "ClusterId": "shop-cluster",
        "AuthorizationPolicy": "ShopWorkerOnly",
        "Match": {              
          "Path": "/shop-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/shop-api"
          }
        ] 
      },
      "user-router": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": null,
        "Match": {
          "Path": "/user-api/{**remainder}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/user-api"
          }
        ] 
      }
    },
    "Clusters": {
      "shop-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://shop-api:8080/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://user-api:8080/"
          }
        }
      }
    }
  }
}
